# OmniRoute — единый LLM endpoint для всей системы
OMNI_ROUTE_URL=http://138.16.224.188:20128/v1
OMNI_ROUTE_KEY=sk-a10f604cd99e7a50-dd1d5a-56e30050

# API Keys (REQUIRED)
# Get your SEMrush API key from: https://www.semrush.com/api-analytics/
SEMRUSH_API_KEY=your_semrush_api_key_here

# Ahrefs API key (OPTIONAL - fallback if SEMrush fails)
# Get your Ahrefs API key from: https://ahrefs.com/api
AHREFS_API_KEY=your_ahrefs_api_key_here

# GitHub Token (OPTIONAL - for Teacher Agent)
# Get your GitHub token from: https://github.com/settings/tokens
# Without token: 60 requests/hour. With token: 5000 requests/hour.
GITHUB_TOKEN=your_github_token_here

# Budget and Limits
# Maximum API cost per request in USD (default: 5.0)
MAX_COST_USD=5.0

# Minimum keywords to return (default: 100)
MIN_KEYWORDS=100

# Minimum search volume filter (default: 10)
MIN_VOLUME=10

# Caching and Rate Limiting
# Cache TTL in seconds (default: 3600 = 1 hour)
CACHE_TTL=3600

# Rate limiter bucket capacity (default: 10)
RATE_LIMIT_CAPACITY=10

# Rate limiter refill rate in requests/sec (default: 1.0)
RATE_LIMIT_REFILL=1.0

# IMPORTANT: Never commit .env file to git!
# Copy this file to .env and fill in your actual API keys.
