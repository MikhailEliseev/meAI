# =============================================================================
# AIM Agency - Environment Configuration
# =============================================================================
# Instructions:
# 1. Copy this file to .env: cp .env.example .env
# 2. Replace placeholder values with your actual credentials
# 3. Never commit .env to git (it's in .gitignore)
# =============================================================================

# -----------------------------------------------------------------------------
# Keyword Research API Keys (Sprint 1)
# -----------------------------------------------------------------------------
# SEMrush API - Primary keyword research provider
# Get your API key from: https://www.semrush.com/api-documentation/
# Pricing: Business plan $499.95/month (50,000 API units/day)
SEMRUSH_API_KEY=your_semrush_api_key_here

# Ahrefs API - Fallback keyword research provider (optional)
# Get your API key from: https://ahrefs.com/api
# Pricing: Advanced + API $949/month ($499 + $450 addon)
AHREFS_API_KEY=your_ahrefs_api_key_here

# Budget and Limits
MAX_COST_USD=5.0                     # Max cost per request
MIN_KEYWORDS=100                     # Min keywords to return
MIN_VOLUME=10                        # Min search volume filter

# Caching and Rate Limiting
CACHE_TTL=3600                       # Cache TTL in seconds (1 hour)
RATE_LIMIT_CAPACITY=10               # Rate limiter capacity
RATE_LIMIT_REFILL=1.0                # Requests per second

# -----------------------------------------------------------------------------
# SERP Data API Keys (Sprint 4)
# -----------------------------------------------------------------------------
# DataForSEO API - SERP data for clustering
# Get your API key from: https://dataforseo.com/
# Pricing: Pay-as-you-go, ~$0.01-0.05 per SERP request
DATAFORSEO_LOGIN=your_dataforseo_login_here
DATAFORSEO_PASSWORD=your_dataforseo_password_here

# ValueSERP API - Alternative SERP provider (optional)
# Get your API key from: https://www.valueserp.com/
# Pricing: $50/month for 10,000 searches
VALUESERP_API_KEY=your_valueserp_api_key_here

# SERP Provider Selection
SERP_PROVIDER=dataforseo              # Options: dataforseo, valueserp, mock

# -----------------------------------------------------------------------------
# Technical SEO API Keys
# -----------------------------------------------------------------------------
# PageSpeed Insights API
# Get your API key from: https://developers.google.com/speed/docs/insights/v5/get-started
# Free tier: 25,000 requests per day
PAGESPEED_API_KEY=your_pagespeed_api_key_here

# Rate limiting configuration
PAGESPEED_REQUESTS_PER_MINUTE=60
PAGESPEED_REQUESTS_PER_DAY=25000

# Cache configuration
PAGESPEED_CACHE_TTL_HOURS=24

# -----------------------------------------------------------------------------
# HH.ru API Configuration (Job Market Analysis)
# -----------------------------------------------------------------------------
# Get your token from https://dev.hh.ru after application approval
HH_ACCESS_TOKEN=your_access_token_here

# Client credentials (optional, for token refresh)
HH_CLIENT_ID=your_client_id_here
HH_CLIENT_SECRET=your_client_secret_here

# -----------------------------------------------------------------------------
# SEO Magister v2 Configuration (Sprint 5)
# -----------------------------------------------------------------------------
# Timeout for complete SEO analysis (seconds)
SEO_ANALYSIS_TIMEOUT=600              # 10 minutes default

# Agent weights (must sum to 1.0)
WEIGHT_TECHNICAL=0.30                 # Technical SEO weight
WEIGHT_CONTENT=0.25                   # Content SEO weight
WEIGHT_LINKS=0.20                     # Links SEO weight
WEIGHT_GAPS=0.25                      # Content gaps weight

# Recommendation thresholds
THRESHOLD_TECHNICAL=70                # Generate tech recommendations if score < 70
THRESHOLD_CONTENT=70                  # Generate content recommendations if score < 70
THRESHOLD_LINKS=70                    # Generate links recommendations if score < 70
THRESHOLD_GAPS=80                     # Generate gap recommendations if score < 80

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./data/aim.db

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO                        # Options: DEBUG, INFO, WARNING, ERROR
LOG_FORMAT=json                       # Options: json, text

# -----------------------------------------------------------------------------
# Production Settings
# -----------------------------------------------------------------------------
# Environment
ENVIRONMENT=development               # Options: development, staging, production

# Security
SECRET_KEY=your_secret_key_here       # Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# -----------------------------------------------------------------------------
# Monitoring and Metrics
# -----------------------------------------------------------------------------
# Prometheus metrics
ENABLE_METRICS=true
METRICS_PORT=9090

# Sentry error tracking (optional)
SENTRY_DSN=your_sentry_dsn_here

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
# Enable/disable features
ENABLE_KEYWORD_EXPANSION=true
ENABLE_SERP_CLUSTERING=true
ENABLE_ARCHITECTURE_PLANNING=true
ENABLE_BRIEF_GENERATION=true
