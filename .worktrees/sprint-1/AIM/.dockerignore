# .dockerignore - Files to exclude from Docker build context

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/
env/
.venv

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.hypothesis/

# Environment
.env
.env.local
.env.*.local

# Git
.git/
.gitignore
.gitattributes

# Documentation
*.md
docs/
!README.md

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml

# Temporary files
tmp/
temp/
*.tmp
*.log

# Database (exclude from image, use volumes)
*.db
*.sqlite
*.sqlite3

# Obsidian (exclude from image, use volumes)
obsidian/

# Monitoring configs (will be mounted)
monitoring/

# Docker
Dockerfile
docker-compose.yml
.dockerignore
