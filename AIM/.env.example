# AIM Agency - Environment Configuration
# Copy this file to .env and fill in your actual values
# Instructions:
# 1. Copy this file: cp .env.example .env
# 2. Replace placeholder values with your actual credentials
# 3. Never commit .env to git (it's in .gitignore)

# ==============================================================================
# Google Analytics 4 (GA4) Configuration
# ==============================================================================
# Required for Traffic Analyzer and Conversion Tracker
# How to get: https://developers.google.com/analytics/devguides/reporting/data/v1/quickstart-client-libraries
# 1. Create a service account in Google Cloud Console
# 2. Download the JSON key file
# 3. Grant the service account access to your GA4 property

# GA4 Property ID (found in GA4 Admin > Property Settings)
GA4_PROPERTY_ID=123456789

# Path to service account JSON file (absolute or relative to project root)
GA4_SERVICE_ACCOUNT_FILE=/path/to/service-account.json

# OR provide service account JSON directly (for cloud deployments)
# GA4_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# ==============================================================================
# Yandex Metrica Configuration
# ==============================================================================
# Required for Traffic Analyzer (Russian market fallback)
# How to get: https://yandex.ru/dev/metrika/doc/api2/intro.html
# 1. Create Yandex account and add your site to Metrica
# 2. Get OAuth token: https://oauth.yandex.ru/authorize?response_type=token&client_id=YOUR_CLIENT_ID

# Yandex Metrica Counter ID (found in Metrica dashboard)
YANDEX_METRICA_COUNTER_ID=12345678

# Yandex OAuth Access Token
YANDEX_METRICA_ACCESS_TOKEN=your_oauth_token_here

# ==============================================================================
# SEMrush API Configuration
# ==============================================================================
# Required for Keyword Research Agent
# How to get: https://www.semrush.com/api-documentation/
# 1. Sign up for SEMrush account
# 2. Subscribe to API plan (starts at $200/month)
# 3. Get API key from Account Settings > API

# SEMrush API Key
SEMRUSH_API_KEY=your_semrush_api_key_here

# ==============================================================================
# Ahrefs API Configuration (Optional)
# ==============================================================================
# Optional fallback for Keyword Research Agent
# How to get: https://ahrefs.com/api/documentation
# 1. Sign up for Ahrefs account
# 2. Subscribe to API plan (starts at $500/month)
# 3. Get API key from Account Settings > API

# Ahrefs API Key (optional, used as fallback)
AHREFS_API_KEY=your_ahrefs_api_key_here

# ==============================================================================
# HH API Configuration
# ==============================================================================
# Get your token from https://dev.hh.ru after application approval

# Access token from HH API
HH_ACCESS_TOKEN=your_access_token_here

# Client credentials (optional, for token refresh)
HH_CLIENT_ID=your_client_id_here
HH_CLIENT_SECRET=your_client_secret_here

# ==============================================================================
# PageSpeed Insights API Configuration
# ==============================================================================
# Get your API key from https://developers.google.com/speed/docs/insights/v5/get-started
# Free tier: 25,000 requests per day

# ==============================================================================
# DaData API Configuration
# ==============================================================================
# Required for Russian company search and competitor discovery
# How to get: https://dadata.ru/api/suggest/party/
# 1. Register at https://dadata.ru/profile/#info
# 2. Get API key from your profile
# Free tier: 10,000 requests per day
DADATA_API_KEY=your_dadata_api_key_here

# SerpAPI Key (required for competitor discovery and SERP analysis)
# How to get: https://serpapi.com/ — sign up, get API key
# Plans start at $50/month (100 searches)
SERPAPI_API_KEY=your_serpapi_api_key_here

# ==============================================================================
# Yandex Maps API Configuration
# ==============================================================================
# Required for competitor popularity scoring (ratings + reviews)
# How to get: https://developer.tech.yandex.ru/
# 1. Register at developer.tech.yandex.ru
# 2. Create a new API key for "JavaScript API и HTTP Геокодер"
# Free tier: 25,000 requests/day
YANDEX_MAPS_API_KEY=your_yandex_maps_api_key_here

# Competitor blacklist — company names that should NEVER appear as competitors
# (e.g., your own projects/clients). Comma-separated, case-insensitive.
# Example: COMPETITOR_BLACKLIST_NAMES=Детство Плюс,Моя Клиника,Дент-Профи
COMPETITOR_BLACKLIST_NAMES=

# PageSpeed Insights API key (optional, but recommended for production)
# Free tier: 25,000 requests per day
PAGESPEED_API_KEY=your_pagespeed_api_key_here

# Rate limiting configuration
PAGESPEED_REQUESTS_PER_MINUTE=60
PAGESPEED_REQUESTS_PER_DAY=25000

# Cache configuration
PAGESPEED_CACHE_TTL_HOURS=24

# ==============================================================================
# API Rate Limiting Configuration
# ==============================================================================
# Controls how many requests per second each API client can make
# Adjust based on your API plan limits

# GA4 API rate limit (requests per second)
GA4_RATE_LIMIT_CAPACITY=10
GA4_RATE_LIMIT_REFILL=1.0

# Yandex Metrica rate limit (requests per second)
YANDEX_RATE_LIMIT_CAPACITY=10
YANDEX_RATE_LIMIT_REFILL=1.0

# SEMrush rate limit (requests per second)
SEMRUSH_RATE_LIMIT_CAPACITY=10
SEMRUSH_RATE_LIMIT_REFILL=1.0

# Ahrefs rate limit (requests per second)
AHREFS_RATE_LIMIT_CAPACITY=10
AHREFS_RATE_LIMIT_REFILL=1.0

# ==============================================================================
# Cache Configuration
# ==============================================================================
# Controls how long API responses are cached to reduce costs

# Cache TTL in seconds (default: 3600 = 1 hour)
CACHE_TTL=3600

# Cache backend (memory, redis)
CACHE_BACKEND=memory

# Redis configuration (if using redis backend)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_PASSWORD=

# ==============================================================================
# Budget and Cost Control
# ==============================================================================
# Prevents runaway API costs

# Maximum cost per API request in USD (SEMrush/Ahrefs)
MAX_COST_USD=5.0

# Minimum keywords to return (prevents empty results)
MIN_KEYWORDS=100

# Minimum search volume filter (reduces noise)
MIN_VOLUME=10

# ==============================================================================
# Logging Configuration
# ==============================================================================
# Controls logging verbosity and output

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log format (json, text)
LOG_FORMAT=json

# Log output (stdout, file)
LOG_OUTPUT=stdout

# Log file path (if LOG_OUTPUT=file)
# LOG_FILE=/var/log/aim/aim.log

# ==============================================================================
# Database Configuration
# ==============================================================================
# SQLite for development, PostgreSQL for production

# Database URL (PostgreSQL for production, SQLite fallback for local dev)
DATABASE_URL=postgresql+asyncpg://aim_user:${POSTGRES_PASSWORD}@postgres:5432/aim_db

# Database pool size (for production with PostgreSQL)
# DATABASE_POOL_SIZE=20
# DATABASE_MAX_OVERFLOW=10

# ==============================================================================
# PostgreSQL Configuration (Production)
# ==============================================================================
POSTGRES_USER=aim_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=aim_db
AUTO_MIGRATE=false  # Set to "true" in production to auto-run migrations

# ==============================================================================
# Obsidian Vault Configuration
# ==============================================================================
# Path to Obsidian vaults for agent memory

# Base path for all agent vaults
OBSIDIAN_BASE_PATH=./AIM/obsidian

# ==============================================================================
# API Timeouts
# ==============================================================================
# Request timeout in seconds

# Default timeout for all API requests
API_TIMEOUT=30.0

# GA4 API timeout
GA4_TIMEOUT=30.0

# Yandex Metrica timeout
YANDEX_TIMEOUT=30.0

# SEMrush timeout
SEMRUSH_TIMEOUT=30.0

# Ahrefs timeout
AHREFS_TIMEOUT=30.0

# ==============================================================================
# Feature Flags
# ==============================================================================
# Enable/disable specific features

# Enable GA4 integration
ENABLE_GA4=true

# Enable Yandex Metrica integration
ENABLE_YANDEX_METRICA=true

# Enable SEMrush integration
ENABLE_SEMRUSH=true

# Enable Ahrefs integration
ENABLE_AHREFS=false

# Enable caching
ENABLE_CACHE=true

# Enable rate limiting
ENABLE_RATE_LIMITING=true

# ==============================================================================
# VK Ads API Configuration
# ==============================================================================
# Required for VK Ads campaign management
# How to get: https://vk.com/dev/ads_api
# 1. Create VK Ads account
# 2. Get access token from VK Ads cabinet → API settings
# Prefix with ADS_ in .env: ADS_VK_ADS_ACCESS_TOKEN, ADS_VK_ADS_ACCOUNT_ID
VK_ADS_ACCESS_TOKEN=your_vk_ads_token_here
VK_ADS_ACCOUNT_ID=your_vk_ads_account_id_here

# ==============================================================================
# Telegram Ads API Configuration
# ==============================================================================
# Required for Telegram promoted messages
# How to get:
# 1. Create a Telegram bot via @BotFather
# 2. Enable advertising permissions
# Prefix with ADS_ in .env: ADS_TELEGRAM_ADS_BOT_TOKEN
TELEGRAM_ADS_BOT_TOKEN=your_telegram_bot_token_here

# ==============================================================================
# Monitoring & Alerting
# ==============================================================================
SENTRY_DSN=https://<key>@sentry.io/<project>
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
TELEGRAM_ADMIN_CHAT_ID=0  # Mikhail's Telegram chat ID — gets ADMIN mode with all 8 tools

# ==============================================================================
# Development/Production Mode
# ==============================================================================

# Environment (development, staging, production)
ENVIRONMENT=development

# Debug mode (enables verbose logging and error details)
DEBUG=false

# ==============================================================================
# Monitoring & Error Tracking
# ==============================================================================

# Sentry DSN for error tracking (https://sentry.io)
# Leave empty to disable Sentry
SENTRY_DSN=

# Prometheus metrics (metrics exposed at /metrics)
ENABLE_METRICS=true

# Slow query threshold in milliseconds (logged by QueryProfilingMiddleware)
SLOW_QUERY_THRESHOLD_MS=100

# ==============================================================================
# Security
# ==============================================================================

# Secret key for session encryption (generate with: openssl rand -hex 32)
SECRET_KEY=your_secret_key_here_generate_with_openssl_rand_hex_32

# AES-256 encryption key for PII fields (generate with: python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())")
AIM_ENCRYPTION_KEY=

# reCAPTCHA v3 secret key for lead capture verification
RECAPTCHA_SECRET_KEY=

# Allowed hosts (comma-separated, for production)
# ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# CORS origins (comma-separated, for API access)
# CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# ==============================================================================
# YooKassa Payment Configuration
# ==============================================================================
# Required for Russian market payment processing
# How to get: https://yookassa.ru/my/shop-settings
# 1. Register at YooKassa (https://yookassa.ru/)
# 2. Get shopId and secret key from shop settings
# Test shopId: 54401, Test secret: test_Fh8hUAVVBGUGbjmlzba6TB0iyUbos_lueTHE-axOwM0

# YooKassa shop ID
YOOKASSA_SHOP_ID=your_shop_id_here

# YooKassa secret key
YOOKASSA_SECRET_KEY=your_secret_key_here

# Return URL after payment (user redirected here after paying on YooKassa page)
YOOKASSA_RETURN_URL=https://iamaim.ru/payment/callback

# ==============================================================================
# Контур.Диадок Configuration (Production)
# ==============================================================================
# Required for Russian market e-signature (replaces DocuSign)
# How to get: https://diadoc.kontur.ru/ → Register → API settings
# Uses OIDC Device Authorization Flow for authentication

# Контур.Диадок OIDC client credentials
KONTOUR_CLIENT_ID=your_client_id_here
KONTOUR_CLIENT_SECRET=your_client_secret_here
KONTOUR_ORGANIZATION_INN=7701234567
KONTOUR_API_URL=https://diadoc-api.kontur.ru

