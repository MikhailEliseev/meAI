# Environment Variables

# reCAPTCHA (Google)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here

# Encryption
NEXT_PUBLIC_ENCRYPTION_KEY=your_encryption_key_here
ENCRYPTION_KEY=your_encryption_key_here

# SendGrid (Phase 9 integration)
SENDGRID_API_KEY=your_sendgrid_api_key_here
CONTACT_EMAIL=info@iamaim.ru
FROM_EMAIL=noreply@iamaim.ru

# Yandex.Metrika
NEXT_PUBLIC_YANDEX_METRIKA_ID=your_yandex_metrika_id_here

# Database (Phase 7.5 integration - future)
DATABASE_URL=postgresql://user:password@localhost:5432/aim_agency
