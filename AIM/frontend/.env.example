# Environment Variables

# reCAPTCHA (Google)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here

# Encryption
NEXT_PUBLIC_ENCRYPTION_KEY=your_encryption_key_here
ENCRYPTION_KEY=your_encryption_key_here

# SendGrid (Phase 9 integration)
SENDGRID_API_KEY=your_sendgrid_api_key_here
CONTACT_EMAIL=info@iamaim.ru
FROM_EMAIL=noreply@iamaim.ru

# Yandex.Metrika
NEXT_PUBLIC_YANDEX_METRIKA_ID=your_yandex_metrika_id_here

# SEO Verification
NEXT_PUBLIC_YANDEX_VERIFICATION=your_yandex_verification_code_here
NEXT_PUBLIC_GOOGLE_VERIFICATION=your_google_verification_code_here

# Database (Phase 7.5 integration - future)
DATABASE_URL=postgresql://user:password@localhost:5432/aim_agency

# Linear CRM (Phase 7.5 integration)
LINEAR_API_KEY=your_linear_api_key_here
LINEAR_TEAM_ID=your_linear_team_id_here
LINEAR_PROJECT_ID=your_linear_project_id_here
LINEAR_SALES_PIPELINE_STATE_ID=your_linear_state_id_here
