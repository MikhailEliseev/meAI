{
  "name": "aim-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:safe": "BUILD_DIR=/tmp/aim-build-$$ && cp -R . \"$BUILD_DIR\" && cd \"$BUILD_DIR\" && next build && rsync -a \"$BUILD_DIR/.next/\" .next/ && rm -rf \"$BUILD_DIR\" && echo 'Build synced back to project'",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:all": "npm run test && npm run test:e2e"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "@hookform/resolvers": "^3.3.0",
    "@sendgrid/mail": "^8.1.6",
    "bullmq": "^5.76.8",
    "clsx": "^2.1.0",
    "framer-motion": "^11.0.0",
    "ioredis": "^5.10.1",
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-hook-form": "^7.51.0",
    "recharts": "^3.8.1",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^2.2.0",
    "uuid": "^14.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^14.2.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.0",
    "critters": "^0.0.23",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.4.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  }
}
