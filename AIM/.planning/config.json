{
  "project_name": "AIM Testing Infrastructure",
  "branching_strategy": "feature-branch",
  "commit_docs": true,
  "text_mode": false,
  "git": {
    "base_branch": "main",
    "branch_prefix": "feat/"
  },
  "workflow": {
    "auto_verify": true,
    "auto_ship": false,
    "code_review_command": ""
  },
  "phases": {
    "completed": [1, 2, 3],
    "current": 4,
    "total": 6
  },
  "testing": {
    "framework": "pytest",
    "async_mode": "pytest-asyncio",
    "coverage_target": 80,
    "test_types": ["unit", "integration", "e2e"]
  }
}
