# meAI Configuration

# Required: Anthropic API key for Claude
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Database connection URL (SQLite by default)
DATABASE_URL=sqlite+aiosqlite:///./data/meai.db

# Obsidian vault path for agent memory
OBSIDIAN_VAULT_PATH=./obsidian

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Claude API rate limit (requests per minute)
CLAUDE_API_RATE_LIMIT=50

# Monthly budget for Claude API (USD)
CLAUDE_API_BUDGET_MONTHLY=100.0

# Telegram alerting (optional - falls back to logging if not provided)
# TELEGRAM_BOT_TOKEN=your_bot_token_here
# TELEGRAM_CHAT_ID=your_chat_id_here
